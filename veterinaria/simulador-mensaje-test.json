      "name": "Normalizar datos del formulario",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "jsCode": "const f = $input.first().json;\nconst phone = String(f['Telefono del dueno'] || '').replace(/\\D/g, '');\nif (!phone) throw new Error('Falta el telefono');\nconst nombre_dueno = f['Nombre del dueno'] || null;\nconst mascota_nombre = f['Nombre de la mascota'] || 'Mascota';\nconst mascota_especie = (f['Especie (perro, gato u otro)'] || 'otro').toLowerCase();\nconst sucursal = f['Sucursal'] || 'principal';\nconst mensaje = f['Mensaje'] || '';\nif (!mensaje) throw new Error('Falta el mensaje');\nreturn [{ json: { phone, nombre_dueno, mascota_nombre, mascota_especie, sucursal, mensaje } }];"
      }
    },
