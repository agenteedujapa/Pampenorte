      "parameters": {
        "formTitle": "Simulador de mensaje - Veterinaria (test)",
        "formDescription": "Simula la llegada de un mensaje de WhatsApp sin usar Whapi. Uso interno para pruebas.",
        "formFields": {
          "values": [
